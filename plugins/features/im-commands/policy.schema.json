{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "access": { "type": "string", "enum": ["user", "bot-admin"] },
    "group": { "$ref": "#/$defs/list" },
    "private": { "$ref": "#/$defs/list" }
  },
  "required": ["access", "group", "private"],
  "additionalProperties": false,
  "$defs": {
    "list": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["whitelist", "blacklist"] },
        "ids": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\s\\u0000-\\u001f\\u007f]+$"
          }
        }
      },
      "required": ["mode", "ids"],
      "additionalProperties": false
    }
  }
}

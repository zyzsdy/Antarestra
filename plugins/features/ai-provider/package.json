{
  "name": "@antarestra/plugin-ai-provider",
  "description": "管理模型提供商、连接凭据与模型目录，支持同步提供商模型。",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "antarestra-plugin"
  ],
  "scripts": {
    "build": "tsc -b && vue-tsc -p tsconfig.client.json --noEmit && vite build",
    "typecheck": "tsc -b && vue-tsc -p tsconfig.client.json --noEmit",
    "dev": "vite build --watch"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@antarestra/ai": "workspace:*",
    "@antarestra/database": "workspace:*",
    "@antarestra/plugin-admin-console": "workspace:*",
    "@antarestra/plugin-sdk": "workspace:*",
    "@antarestra/plugin-server": "workspace:*",
    "@antarestra/rbac": "workspace:*",
    "@antarestra/webui": "workspace:*",
    "@earendil-works/pi-ai": "^0.99.1",
    "openai": "^7.23.0"
  },
  "antarestra": {
    "title": "模型提供商管理",
    "configSchema": "./config.schema.json",
    "multipleInstances": false
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}

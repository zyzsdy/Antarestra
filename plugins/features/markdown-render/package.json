{
  "name": "@antarestra/plugin-markdown-render",
  "description": "提供共享 Markdown 渲染服务，支持流式内容、代码块和 Mermaid 图表。",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "antarestra": {
    "title": "Markdown 渲染",
    "multipleInstances": false,
    "configSchema": "./config.schema.json"
  },
  "keywords": [
    "antarestra-plugin"
  ],
  "scripts": {
    "build": "tsc -b && vue-tsc -p tsconfig.client.json --noEmit && vite build",
    "typecheck": "tsc -b && vue-tsc -p tsconfig.client.json --noEmit",
    "dev": "vite build --watch"
  },
  "exports": {
    "./client": "./client/api.ts",
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@antarestra/markdown": "workspace:*",
    "@antarestra/plugin-sdk": "workspace:*",
    "@antarestra/plugin-server": "workspace:*",
    "@antarestra/webui": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}

{
  "name": "@antarestra/plugin-workspace-file",
  "description": "提供工作空间文件与存储配额管理页面，支持上传、下载和删除文件。",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "antarestra-plugin"
  ],
  "scripts": {
    "build": "tsc -b && vue-tsc -p tsconfig.client.json --noEmit && vite build",
    "typecheck": "tsc -b && vue-tsc -p tsconfig.client.json --noEmit",
    "dev": "vite build --watch"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./client/api.ts",
      "default": "./client/api.ts"
    }
  },
  "dependencies": {
    "@antarestra/ai": "workspace:*",
    "@antarestra/database": "workspace:*",
    "@antarestra/im": "workspace:*",
    "@antarestra/plugin-admin-console": "workspace:*",
    "@antarestra/plugin-sdk": "workspace:*",
    "@antarestra/plugin-server": "workspace:*",
    "@antarestra/rbac": "workspace:*",
    "@antarestra/storage": "workspace:*",
    "@antarestra/webui": "workspace:*",
    "mime-types": "^3.0.2"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "antarestra": {
    "title": "工作空间文件",
    "multipleInstances": false,
    "configSchema": "./config.schema.json"
  }
}

{
  "name": "@antarestra/plugin-im-stickers-lib",
  "description": "全局共享表情包库，支持控制台管理、模板列表和 IM 命令。",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "antarestra-plugin"
  ],
  "scripts": {
    "build": "tsc -b && vue-tsc -p tsconfig.client.json --noEmit && vite build",
    "typecheck": "tsc -b && vue-tsc -p tsconfig.client.json --noEmit",
    "dev": "vite build --watch"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@antarestra/ai": "workspace:*",
    "@antarestra/database": "workspace:*",
    "@antarestra/im": "workspace:*",
    "@antarestra/plugin-admin-console": "workspace:*",
    "@antarestra/plugin-im-commands": "workspace:*",
    "@antarestra/plugin-sdk": "workspace:*",
    "@antarestra/plugin-server": "workspace:*",
    "@antarestra/plugin-workspace-file": "workspace:*",
    "@antarestra/rbac": "workspace:*",
    "@antarestra/webui": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "antarestra": {
    "title": "全局表情包库",
    "multipleInstances": false,
    "configSchema": "./config.schema.json"
  }
}

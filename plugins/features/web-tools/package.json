{
  "name": "@antarestra/plugin-web-tools",
  "description": "为 AI 提供本地网页搜索、页面阅读、交互和截图工具。",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "antarestra-plugin"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "antarestra": {
    "title": "网页工具",
    "multipleInstances": false,
    "configSchema": "./config.schema.json"
  },
  "dependencies": {
    "@antarestra/ai": "workspace:*",
    "@antarestra/http": "workspace:*",
    "@antarestra/plugin-sdk": "workspace:*",
    "@antarestra/puppeteer": "workspace:*",
    "@napi-rs/canvas": "^1.0.10",
    "pdfjs-dist": "^6.3.289"
  }
}

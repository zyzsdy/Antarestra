{
  "name": "@antarestra/plugin-im-ai",
  "description": "IM 消息激活、空间共享 AI 会话与持久化回复关联。",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "antarestra-plugin"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "antarestra": {
    "title": "IM AI",
    "multipleInstances": false,
    "configSchema": "./config.schema.json"
  },
  "dependencies": {
    "@antarestra/ai": "workspace:*",
    "@antarestra/database": "workspace:*",
    "@antarestra/im": "workspace:*",
    "@antarestra/plugin-im-commands": "workspace:*",
    "@antarestra/plugin-sdk": "workspace:*"
  }
}

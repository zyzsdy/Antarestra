{
  "name": "@antarestra/plugin-chat-webui",
  "description": "提供网页聊天入口，支持对话历史、流式回复、消息编辑与重新生成。",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "antarestra-plugin"
  ],
  "scripts": {
    "build": "tsc -b && vue-tsc -p tsconfig.client.json --noEmit && vite build",
    "typecheck": "tsc -b && vue-tsc -p tsconfig.client.json --noEmit",
    "dev": "vite build --watch"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@antarestra/contracts": "workspace:*",
    "@antarestra/plugin-markdown-render": "workspace:*",
    "@antarestra/plugin-sdk": "workspace:*",
    "@antarestra/plugin-server": "workspace:*",
    "@antarestra/plugin-workspace-file": "workspace:*",
    "@antarestra/rbac": "workspace:*",
    "@antarestra/webui": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "^8.2.2",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "antarestra": {
    "title": "网页聊天",
    "configSchema": "./config.schema.json",
    "multipleInstances": false
  }
}

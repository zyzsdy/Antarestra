{
  "type": "object",
  "properties": {
    "policy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "group": {
          "$ref": "#/$defs/access"
        },
        "chats": {
          "additionalProperties": {
            "$ref": "#/$defs/chat"
          },
          "type": "object"
        },
        "private": {
          "$ref": "#/$defs/access"
        },
        "defaults": {
          "$ref": "#/$defs/chat"
        }
      },
      "additionalProperties": false,
      "description": "硬性聊天准入范围，省略的聊天类型全部拒绝"
    },
    "botOpenId": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "appId": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string"
    },
    "appSecretEnv": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "appSecret": {
      "format": "password",
      "minLength": 1,
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "required": ["id", "appId", "tenantId", "botOpenId"],
  "oneOf": [
    {
      "required": ["appSecret"]
    },
    {
      "required": ["appSecretEnv"]
    }
  ],
  "$defs": {
    "access": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mode": {
          "type": "string",
          "enum": ["whitelist", "blacklist"]
        },
        "defaults": {
          "$ref": "#/$defs/chat"
        }
      },
      "required": ["mode", "ids"]
    },
    "chat": {
      "type": "object",
      "properties": {
        "ai": {
          "type": "boolean"
        },
        "agentId": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "activation": {
          "$ref": "#/$defs/activation"
        },
        "queueLimit": {
          "minimum": 0,
          "type": "integer",
          "maximum": 100
        },
        "commands": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "activation": {
      "type": "object",
      "properties": {
        "dynamic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseProbability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hotProbability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hotDurationMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 3600000
            },
            "maxSilentMessages": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          }
        },
        "maxPerMinute": {
          "minimum": 1,
          "type": "integer"
        },
        "cooldownMs": {
          "minimum": 0,
          "type": "integer"
        },
        "reply": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": ["any", "all"]
        },
        "mention": {
          "type": "boolean"
        },
        "keywords": {
          "items": {
            "type": "string",
            "minLength": 1
          },
          "type": "array"
        },
        "always": {
          "type": "boolean"
        },
        "prefixes": {
          "items": {
            "type": "string",
            "minLength": 1
          },
          "type": "array"
        }
      },
      "additionalProperties": false
    }
  }
}

{
  "additionalProperties": false,
  "required": ["id", "selfId"],
  "properties": {
    "path": {
      "type": "string",
      "pattern": "^/"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "selfId": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "ignoredUserIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rpcTimeoutMs": {
      "minimum": 100,
      "maximum": 120000,
      "default": 15000,
      "type": "integer"
    },
    "filterCitationLinks": {
      "type": "boolean",
      "default": false,
      "title": "过滤引用链接",
      "description": "发送时移除括号内的 Markdown 引用链接，其他 Markdown 网页链接保留标题；保留裸链接、代码和图片。仅影响当前 OneBot 接入。"
    },
    "tokenEnv": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string"
    },
    "token": {
      "format": "password",
      "minLength": 1,
      "type": "string"
    }
  },
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "required": ["token"]
    },
    {
      "required": ["tokenEnv"]
    }
  ]
}

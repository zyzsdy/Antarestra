{
  "additionalProperties": false,
  "required": ["id", "selfId"],
  "properties": {
    "provider": {
      "type": "string",
      "enum": ["napcat", "snowluma"],
      "default": "snowluma",
      "title": "OneBot 提供方",
      "description": "所连接的 OneBot 实现；共用 OneBot 11 收发协议，视频和文件下载按提供方适配。"
    },
    "path": {
      "type": "string",
      "pattern": "^/"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "selfId": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "ignoredUserIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rpcTimeoutMs": {
      "minimum": 100,
      "maximum": 120000,
      "default": 15000,
      "type": "integer"
    },
    "maxPayloadMiB": {
      "minimum": 1,
      "maximum": 256,
      "default": 136,
      "type": "integer",
      "title": "WebSocket 消息大小上限",
      "description": "单位 MiB，包含 JSON 和 base64。默认允许接收 100 MiB 媒体编码后的响应；超过上限会关闭连接，此值不改变媒体归档大小限制。"
    },
    "filterCitationLinks": {
      "type": "boolean",
      "default": false,
      "title": "过滤引用链接",
      "description": "发送时移除括号内的 Markdown 引用链接，其他 Markdown 网页链接保留标题；保留裸链接、代码和图片。仅影响当前 OneBot 接入。"
    },
    "tokenEnv": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string"
    },
    "token": {
      "format": "password",
      "minLength": 1,
      "type": "string"
    }
  },
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "required": ["token"]
    },
    {
      "required": ["tokenEnv"]
    }
  ]
}

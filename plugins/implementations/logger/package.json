{
  "name": "@antarestra/plugin-logger",
  "description": "将系统日志输出到控制台或记录为文件。未启用时系统仍会产生日志，但无法通过此插件查看。",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "build": "tsc -b"
  },
  "keywords": [
    "antarestra-plugin"
  ],
  "dependencies": {
    "@antarestra/plugin-sdk": "workspace:*"
  },
  "antarestra": {
    "title": "日志服务",
    "configSchema": "./config.schema.json",
    "multipleInstances": false
  }
}

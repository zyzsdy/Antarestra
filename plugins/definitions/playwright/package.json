{
  "name": "@antarestra/playwright",
  "description": "提供 Playwright 浏览器、隔离页面上下文及自动回收。",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "antarestra-plugin"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "antarestra": {
    "title": "Playwright 浏览器服务",
    "multipleInstances": false,
    "configSchema": "./config.schema.json"
  },
  "dependencies": {
    "@antarestra/plugin-sdk": "workspace:*",
    "playwright-core": "^1.63.0"
  }
}

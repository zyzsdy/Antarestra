{
  "name": "@antarestra/ai",
  "description": "统一管理 Agent、模型、工具和 Skill，提供按工作空间隔离的对话、运行与历史接口。",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": [
    "antarestra-plugin"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "antarestra": {
    "title": "AI 服务",
    "configSchema": "./config.schema.json",
    "multipleInstances": false
  },
  "dependencies": {
    "@antarestra/contracts": "workspace:*",
    "@antarestra/database": "workspace:*",
    "@antarestra/plugin-sdk": "workspace:*",
    "@antarestra/plugin-server": "workspace:*",
    "@antarestra/rbac": "workspace:*",
    "ajv": "^8.20.0"
  }
}

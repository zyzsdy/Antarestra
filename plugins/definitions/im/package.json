{
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b",
    "build": "tsc -b"
  },
  "version": "0.1.0",
  "antarestra": {
    "title": "即时消息服务",
    "configSchema": "./config.schema.json",
    "multipleInstances": false
  },
  "private": true,
  "name": "@antarestra/im",
  "description": "即时消息服务",
  "exports": {
    "./activation": {
      "types": "./dist/activation.d.ts",
      "development": "./src/activation.ts",
      "default": "./dist/activation.js"
    },
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts"
    }
  },
  "keywords": [
    "antarestra-plugin"
  ],
  "dependencies": {
    "@antarestra/database": "workspace:*",
    "@antarestra/plugin-sdk": "workspace:*"
  }
}

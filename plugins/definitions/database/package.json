{
  "name": "@antarestra/database",
  "description": "提供统一数据库接口和插件迁移契约，支持插件在事务中操作各自的数据。",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "build": "tsc -b"
  },
  "keywords": [
    "antarestra-plugin"
  ],
  "dependencies": {
    "@antarestra/plugin-sdk": "workspace:*",
    "kysely": "^0.29.5"
  },
  "antarestra": {
    "title": "数据库服务",
    "configSchema": "./config.schema.json",
    "multipleInstances": false
  }
}

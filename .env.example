# 复制为与 antarestra.yml 同级的 .env，不要提交真实凭据。
# 仅在 YAML 中显式使用 $变量名 时生效，进程环境优先（包括空字符串）。
# 管理员配置：bootstrapPassword: $ANTARESTRA_ADMIN_PASSWORD
# 替换为自己的 8–128 字符密码；初始化后删除相关配置。
ANTARESTRA_ADMIN_PASSWORD=请替换为自己的管理员密码

# PostgreSQL 配置：type: postgresql 和 url: $ANTARESTRA_DATABASE_URL
ANTARESTRA_DATABASE_URL=postgres://用户名:URL编码后的密码@127.0.0.1:5432/antarestra

# 后续插件可通过 $ANTARESTRA_API_KEY 引用。
ANTARESTRA_API_KEY=请替换为自己的API密钥

# 本地 RustFS：运行 pnpm startdevstorage 后，从 .env.storage.local 复制到启动环境。
# 配置 storage-s3 时使用以下引用；不要填写或提交真实密钥。
# ANTARESTRA_S3_ACCESS_KEY=你的存储访问密钥
# ANTARESTRA_S3_SECRET_KEY=你的存储秘密密钥

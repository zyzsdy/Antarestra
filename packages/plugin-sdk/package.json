{
  "name": "@antarestra/plugin-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "development": "./src/loader.ts",
      "default": "./dist/loader.js"
    },
    "./hmr": {
      "types": "./dist/hmr.d.ts",
      "development": "./src/hmr.ts",
      "default": "./dist/hmr.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "build": "tsc -b"
  },
  "dependencies": {
    "@cordisjs/plugin-hmr": "^1.1.0",
    "@cordisjs/plugin-loader": "1.0.0-rc.7",
    "@cordisjs/plugin-timer": "^1.1.3",
    "cordis": "4.0.0-rc.10"
  }
}

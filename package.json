{
  "name": "antarestra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "startdevdb": "docker compose -p antarestra-dev -f compose.dev.yml up -d --wait",
    "dev": "pnpm build && pnpm -r --parallel --filter @antarestra/server --filter @antarestra/webui --filter @antarestra/plugin-auth-local dev",
    "dev:server": "pnpm --filter @antarestra/server dev",
    "dev:web": "pnpm -r --parallel --filter @antarestra/webui --filter @antarestra/plugin-auth-local dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "start": "pnpm --filter @antarestra/server start"
  },
  "devDependencies": {
    "@antarestra/agent": "workspace:*",
    "@antarestra/agent-demo": "workspace:*",
    "@antarestra/config-loader": "workspace:*",
    "@antarestra/database": "workspace:*",
    "@antarestra/plugin-auth-local": "workspace:*",
    "@antarestra/plugin-database-kysely": "workspace:*",
    "@antarestra/plugin-hmr": "workspace:*",
    "@antarestra/plugin-logger": "workspace:*",
    "@antarestra/plugin-sdk": "workspace:*",
    "@antarestra/plugin-server": "workspace:*",
    "@antarestra/rbac": "workspace:*",
    "@antarestra/webui": "workspace:*",
    "@types/node": "^24.13.3",
    "prettier": "^3.9.6",
    "selfsigned": "^5.5.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
